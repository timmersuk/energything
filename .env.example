# Replace placeholders before starting. The application never loads .env.
# Docker Compose reads its project .env for substitution.
ENERGYTHING_USERNAME=
ENERGYTHING_PASSWORD=
ENERGYTHING_HTTP_ADDR=:8080
ENERGYTHING_DATA_DIR=./energything-data
ENERGYTHING_TIMEZONE=Europe/London
# Inclusive automatic history boundary (YYYY-MM-DD). Restart after changing.
ENERGYTHING_HISTORY_START=2022-01-01
ENERGYTHING_SHUTDOWN_TIMEOUT=10s
ENERGYTHING_IMAGE=energything:local
ENERGYTHING_HTTP_PORT=8080
ENERGYTHING_STOP_GRACE_PERIOD=30s
ENERGYTHING_DATA_PATH=./energything-data
OCTOPUS_API_KEY=
OCTOPUS_ACCOUNT_NUMBER=
OCTOPUS_IMPORT_MPAN=
OCTOPUS_IMPORT_SERIAL=
OCTOPUS_EXPORT_MPAN=
OCTOPUS_EXPORT_SERIAL=
OCTOPUS_REFRESH_INTERVAL=1h
GROWATT_API_TOKEN=
GROWATT_PLANT_ID=
GROWATT_DEVICE_SERIAL=
GROWATT_LATEST_INTERVAL=5m
GROWATT_HISTORY_INTERVAL=1h
# Optional local 10-per-rolling-24h cap (off by default);
# five-minute spacing and provider-directed backoff remain enforced.
GROWATT_AGGREGATE_DAILY_CAP_ENABLED=false
